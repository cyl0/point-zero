function(point_zero_september_source input output)
    file(READ "${input}" text)
    string(REGEX MATCHALL "0x[0-9a-fA-F]+" literals "${text}")
    list(REMOVE_DUPLICATES literals)
    foreach(literal IN LISTS literals)
        string(LENGTH "${literal}" length)
        if(length GREATER 10)
            continue()
        endif()
        math(EXPR value "${literal}" OUTPUT_FORMAT DECIMAL)
        foreach(binding IN LISTS PZ_SEPTEMBER_RVAS)
            string(REPLACE ":" ";" fields "${binding}")
            list(GET fields 0 before)
            list(GET fields 1 after)
            if(value EQUAL before)
                string(REPLACE "${literal}" "PZ_BINDING_${after}_END" text "${text}")
                break()
            endif()
        endforeach()
    endforeach()
    string(REGEX REPLACE "PZ_BINDING_([0-9]+)_END" "\\1" text "${text}")
    string(REPLACE "point_zero::" "point_zero::september::" text "${text}")
    string(REPLACE "using namespace point_zero;" "using namespace point_zero::september;" text "${text}")
    string(REPLACE "point_zero_get_api_august" "point_zero_get_api_september" text "${text}")
    foreach(symbol IN ITEMS list_draw_dispatch list_draw_entry sort_dispatch sort_entry filter_apply_dispatch filter_level_dispatch filter_apply_entry filter_level_entry category_summary_invoke)
        string(REPLACE "pz_${symbol}" "pz_september_${symbol}" text "${text}")
    endforeach()
    if(input MATCHES "catalog_contract.cpp$")
        string(REPLACE "std::byte{0xfb},\n            std::byte{0xf0}, std::byte{0x33}" "std::byte{0xbb},\n            std::byte{0xe3}, std::byte{0x33}" text "${text}")
    endif()
    if(input MATCHES "played_mid_patch.cpp$")
        string(REPLACE "std::byte{0xf0}, std::byte{0xdf}, std::byte{0x05}" "std::byte{0xf0}, std::byte{0xbf}, std::byte{0x05}" text "${text}")
        string(REPLACE "std::byte{0xc0}, std::byte{0xe2}, std::byte{0x05}" "std::byte{0xc0}, std::byte{0xc2}, std::byte{0x05}" text "${text}")
    endif()
    if(EXISTS "${output}")
        file(READ "${output}" previous)
        if(previous STREQUAL text)
            return()
        endif()
    endif()
    file(WRITE "${output}" "${text}")
endfunction()

set(PZ_SEPTEMBER_ROOT "${CMAKE_CURRENT_BINARY_DIR}/generated/september")
file(MAKE_DIRECTORY "${PZ_SEPTEMBER_ROOT}/native" "${PZ_SEPTEMBER_ROOT}/core")
file(GLOB PZ_NATIVE_HEADERS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/native/*.hpp")
file(GLOB PZ_NATIVE_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/native/*.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/src/native/*.asm")
foreach(input IN LISTS PZ_NATIVE_HEADERS PZ_NATIVE_SOURCES)
    get_filename_component(name "${input}" NAME)
    point_zero_september_source("${input}" "${PZ_SEPTEMBER_ROOT}/native/${name}")
endforeach()
foreach(name IN ITEMS api.cpp runtime.cpp runtime.hpp)
    point_zero_september_source("${CMAKE_CURRENT_SOURCE_DIR}/src/core/${name}" "${PZ_SEPTEMBER_ROOT}/core/${name}")
endforeach()
file(WRITE "${PZ_SEPTEMBER_ROOT}/core/prepared.hpp" "#pragma once\n#include \"${CMAKE_CURRENT_SOURCE_DIR}/src/core/prepared.hpp\"\nnamespace point_zero::september { namespace ratings = ::point_zero::ratings; }\nnamespace point_zero::september::core {\nusing ::point_zero::core::NativeRequest;\nint32_t initialize_native(std::unique_ptr<PZ_Prepared>, NativeRequest, PZ_Diagnostic) noexcept;\nvoid shutdown_native() noexcept;\n}\n")
set(PZ_SEPTEMBER_SOURCES "${PZ_SEPTEMBER_ROOT}/core/api.cpp" "${PZ_SEPTEMBER_ROOT}/core/runtime.cpp")
foreach(input IN LISTS PZ_NATIVE_SOURCES)
    get_filename_component(name "${input}" NAME)
    list(APPEND PZ_SEPTEMBER_SOURCES "${PZ_SEPTEMBER_ROOT}/native/${name}")
endforeach()
add_library(point_zero_native_september STATIC ${PZ_SEPTEMBER_SOURCES})
target_include_directories(point_zero_native_september BEFORE PRIVATE "${PZ_SEPTEMBER_ROOT}")
target_include_directories(point_zero_native_september PRIVATE include src)
target_include_directories(point_zero_native_september SYSTEM PRIVATE "${POINT_ZERO_RAPIDJSON_INCLUDE_DIR}")
target_link_libraries(point_zero_native_september PRIVATE point_zero_ratings safetyhook::safetyhook)
target_compile_features(point_zero_native_september PRIVATE cxx_std_23)
target_compile_definitions(point_zero_native_september PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX POINT_ZERO_MULTI_BUILD_CORE POINT_ZERO_NATIVE_DATECODE="2026090900")
point_zero_warnings(point_zero_native_september)
target_compile_definitions(point_zero_core PRIVATE POINT_ZERO_MULTI_BUILD_CORE)
target_sources(point_zero_core PRIVATE src/core/build_dispatch.cpp)
target_link_libraries(point_zero_core PRIVATE point_zero_native_september)
